{
    "name": "nextcloud/vtramit",
    "description": "App for procedures management",
    "type": "project",
    "license": "AGPL",
    "authors": [],
    "require": {
        "zircote/swagger-php": "^3.2"
    },
    "require-dev": {
        "nextcloud/coding-standard": "^1.2",
        "phpunit/phpunit": "^10"
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true
    },
    "scripts": {
        "lint": "find . -name \\*.php -not -path './vendor/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "autoload-dev": {
    "psr-4": {
        "OCA\\VTramit\\": "lib/",
        "OCA\\VTramit\\Test\\Phpunit\\": "test/phpunit/",
        "OCA\\VTramit\\Test\\Phpunit\\Helpers\\": "test/phpunit/lib/Helpers/"
    }
}
}
