#!/usr/bin/env bash
# vtramit-update — install/upgrade the vtramit Nextcloud app from a release tarball.
#
# Lives inside the app directory (e.g. /var/www/nextcloud/apps/vtramit/vtramit-update).
# Auto-detects the Nextcloud root from its own location.
#
# Usage:
#   sudo vtramit-update                  # download and apply the latest release
#   sudo vtramit-update v2.5.0           # apply a specific tag
#   sudo vtramit-update --check          # show what would change, no changes
#   sudo vtramit-update -y               # skip confirmation prompt
#   sudo vtramit-update --tarball FILE   # apply a local tarball, no download
#   sudo vtramit-update --help
#
# Token (private repo): place in /etc/vtramit/gitlab-token (mode 0600 root)
#                       or export VTRAMIT_TOKEN=glpat-...
set -euo pipefail

# Force C locale for the whole script: sort+comm need to agree on byte
# ordering, and on systems with LANG=*.UTF-8 GNU comm exits non-zero
# ("input is not in sorted order") which combined with `set -e` aborts
# the upgrade right after downloading the tarball.
export LC_ALL=C

GITLAB_BASE="${GITLAB_BASE:-https://gitlab.gitlab.videoatencion.com}"
PROJECT_PATH="${PROJECT_PATH:-videoatencion/vtramit/vtramit-app}"
TOKEN_FILE="${VTRAMIT_TOKEN_FILE:-/etc/vtramit/gitlab-token}"
WWW_USER="${WWW_USER:-www-data}"
BACKUP_DIR="${BACKUP_DIR:-/var/backups/vtramit}"

VERSION="latest"
DO_CHECK=0
ASSUME_YES=0
LOCAL_TARBALL=""
SKIP_OCC=0

die()  { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }

# Run a command as $WWW_USER. Works on bare-metal and in containers without sudo.
as_www() {
  local cmd=""
  for a in "$@"; do cmd="$cmd $(printf '%q' "$a")"; done
  su "$WWW_USER" -s /bin/sh -c "$cmd"
}

usage() { sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0; }

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage ;;
    --check)   DO_CHECK=1 ;;
    -y|--yes)  ASSUME_YES=1 ;;
    --tarball) LOCAL_TARBALL="$2"; shift ;;
    --skip-occ-upgrade) SKIP_OCC=1 ;;
    -*) die "unknown flag: $1" ;;
    *)  VERSION="$1" ;;
  esac
  shift
done

[ "$(id -u)" = 0 ] || die "run as root (sudo)"

SCRIPT="$(readlink -f "$0")"
APP_DIR="$(dirname "$SCRIPT")"
NC_ROOT="$(dirname "$(dirname "$APP_DIR")")"
[ -f "$NC_ROOT/occ" ] || die "could not find Nextcloud root (looked for $NC_ROOT/occ)"
[ -f "$APP_DIR/appinfo/info.xml" ] || die "$APP_DIR doesn't look like a vtramit install"

CURRENT_VERSION="$(php -r 'echo (string)simplexml_load_file($argv[1])->version;' "$APP_DIR/appinfo/info.xml" 2>/dev/null || echo unknown)"

TOKEN=""
if [ -n "${VTRAMIT_TOKEN:-}" ]; then
  TOKEN="$VTRAMIT_TOKEN"
elif [ -r "$TOKEN_FILE" ]; then
  TOKEN="$(cat "$TOKEN_FILE")"
fi

curl_auth=()
[ -n "$TOKEN" ] && curl_auth=(--header "PRIVATE-TOKEN: $TOKEN")

TMP="$(mktemp -d -t vtramit-upgrade.XXXXXX)"
trap 'rm -rf "$TMP"' EXIT

#----------------------------------------------------------------- 1. fetch
if [ -n "$LOCAL_TARBALL" ]; then
  info "Using local tarball: $LOCAL_TARBALL"
  cp "$LOCAL_TARBALL" "$TMP/new.tgz"
else
  if [ "$VERSION" = "latest" ]; then
    # Resolve latest release tag via API (web /permalink/latest route doesn't accept PRIVATE-TOKEN)
    ENC_PATH="$(printf '%s' "$PROJECT_PATH" | sed 's|/|%2F|g')"
    TAG=$(curl --fail --silent --show-error "${curl_auth[@]}" \
            "$GITLAB_BASE/api/v4/projects/$ENC_PATH/releases?per_page=1" \
          | grep -o '"tag_name":"[^"]*"' | head -1 \
          | sed 's/.*"tag_name":"\([^"]*\)".*/\1/') \
      || die "could not query GitLab API (auth? network?)"
    [ -n "$TAG" ] || die "no releases found at $PROJECT_PATH"
    info "Latest release: $TAG"
    VERSION="$TAG"
  fi
  URL="$GITLAB_BASE/$PROJECT_PATH/-/releases/${VERSION}/downloads/binaries/vtramit.tar.gz"
  info "Downloading $URL"
  curl --fail --location --silent --show-error "${curl_auth[@]}" "$URL" -o "$TMP/new.tgz" \
    || die "download failed (HTTP error or auth issue — set VTRAMIT_TOKEN or $TOKEN_FILE)"
fi

#----------------------------------------------------------------- 2. extract & inspect
tar -xzf "$TMP/new.tgz" -C "$TMP"
[ -d "$TMP/vtramit" ] || die "tarball does not contain a vtramit/ root"
NEW="$TMP/vtramit"
[ -f "$NEW/MANIFEST.txt" ] || die "tarball missing MANIFEST.txt — is this a real release tarball?"
NEW_VERSION="$(php -r 'echo (string)simplexml_load_file($argv[1])->version;' "$NEW/appinfo/info.xml")"

info "Current version: $CURRENT_VERSION"
info "New version:     $NEW_VERSION"

if [ "$CURRENT_VERSION" = "$NEW_VERSION" ] && [ $DO_CHECK -eq 0 ]; then
  warn "Already at $CURRENT_VERSION. Use --check to inspect, or pass a different tag to force."
fi

#----------------------------------------------------------------- 3. compute changes
KEEP="$APP_DIR/.upgrade-keep"
[ -f "$KEEP" ] || KEEP=/dev/null

# Files in old install but no longer in new release (excluding kept files).
DELETED_LIST="$TMP/to-delete.txt"
: > "$DELETED_LIST"
if [ -f "$APP_DIR/MANIFEST.txt" ]; then
  comm -23 \
    <(awk '{print $2}' "$APP_DIR/MANIFEST.txt" | LC_ALL=C sort) \
    <(awk '{print $2}' "$NEW/MANIFEST.txt"      | LC_ALL=C sort) \
    > "$TMP/removed-upstream.txt"

  if [ "$KEEP" != /dev/null ] && [ -s "$KEEP" ]; then
    grep -vxFf <(grep -v '^[[:space:]]*#' "$KEEP" | grep -v '^[[:space:]]*$') \
      "$TMP/removed-upstream.txt" > "$DELETED_LIST" || true
  else
    cp "$TMP/removed-upstream.txt" "$DELETED_LIST"
  fi
else
  warn "No existing MANIFEST.txt at $APP_DIR — first migration from a non-tarball install."
  warn "No files will be deleted in this upgrade. Future upgrades will use MANIFEST diff."
fi

# Dry-run rsync to show changes.
RSYNC_PLAN="$TMP/rsync-plan.txt"
rsync -ain --exclude-from="$KEEP" "$NEW/" "$APP_DIR/" > "$RSYNC_PLAN" || true

added=$(awk '/^>f\+{9}/ {n++} END {print n+0}' "$RSYNC_PLAN")
modified=$(awk '/^>f[^+]/ {n++} END {print n+0}' "$RSYNC_PLAN")
deleted=$(wc -l < "$DELETED_LIST" | tr -d ' ')

info "Plan: $added new file(s), $modified updated, $deleted to delete"
if [ $DO_CHECK -eq 1 ]; then
  echo
  echo "--- files to add/update ---"
  grep -E '^>f' "$RSYNC_PLAN" | sed 's/^/  /' | head -100
  echo "--- files to delete ---"
  sed 's/^/  /' "$DELETED_LIST" | head -100
  echo
  info "Dry run only. Re-run without --check to apply."
  exit 0
fi

if [ "$ASSUME_YES" -ne 1 ]; then
  read -r -p "Apply? [y/N] " ans
  case "$ans" in y|Y|yes|YES) ;; *) info "Aborted."; exit 0 ;; esac
fi

#----------------------------------------------------------------- 4. backup
mkdir -p "$BACKUP_DIR"
BACKUP="$BACKUP_DIR/vtramit-${CURRENT_VERSION}-$(date +%Y%m%d-%H%M%S).tar.gz"
info "Creating backup: $BACKUP"
tar czf "$BACKUP" -C "$(dirname "$APP_DIR")" "$(basename "$APP_DIR")"

#----------------------------------------------------------------- 5. apply
info "Enabling Nextcloud maintenance mode"
as_www php "$NC_ROOT/occ" maintenance:mode --on

restore_on_failure() {
  warn "Failure detected — disabling maintenance mode (manual rollback may be needed: tar xzf $BACKUP -C $(dirname "$APP_DIR")/ )"
  as_www php "$NC_ROOT/occ" maintenance:mode --off || true
}
trap 'rm -rf "$TMP"; restore_on_failure' EXIT

info "Removing files no longer present upstream ($deleted)"
while IFS= read -r f; do
  [ -z "$f" ] && continue
  rm -f -- "$APP_DIR/$f"
done < "$DELETED_LIST"

info "Syncing new files"
rsync -a --exclude-from="$KEEP" "$NEW/" "$APP_DIR/"

info "Fixing ownership"
chown -R "$WWW_USER":"$WWW_USER" "$APP_DIR"

if [ $SKIP_OCC -eq 0 ]; then
  info "Running occ upgrade"
  as_www php "$NC_ROOT/occ" upgrade
fi

info "Disabling maintenance mode"
as_www php "$NC_ROOT/occ" maintenance:mode --off

trap 'rm -rf "$TMP"' EXIT
info "Done. $CURRENT_VERSION → $NEW_VERSION (backup: $BACKUP)"
